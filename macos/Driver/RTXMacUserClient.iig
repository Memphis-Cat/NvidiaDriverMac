#ifndef RTXMacUserClient_h
#define RTXMacUserClient_h

#include <DriverKit/IOUserClient.iig>

class RTXMacUserClient : public IOUserClient {
public:
  virtual bool init() override;
  virtual void free() override;
  virtual kern_return_t Start(IOService* provider) override;
  virtual kern_return_t Stop(IOService* provider) override;
  virtual kern_return_t ExternalMethod(
      uint64_t selector,
      IOUserClientMethodArguments* arguments,
      const IOUserClientMethodDispatch* dispatch,
      OSObject* target,
      void* reference) override;

  kern_return_t ValidatePackage(IOUserClientMethodArguments* arguments) LOCALONLY;
  kern_return_t GetValidationStatus(IOUserClientMethodArguments* arguments) LOCALONLY;
  kern_return_t StagePackage(IOUserClientMethodArguments* arguments) LOCALONLY;
  kern_return_t GetStagingStatus(IOUserClientMethodArguments* arguments) LOCALONLY;
};

#endif
